extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12 
        +box-head(pageTitle)


    .row
      each item in tours
        .col-6.mb-3 
          .card
            img(src=item.images)
            .card-body
              h5.card-title= item.title
              b(class="mr-2.mb-2") #{item.price_special.toLocaleString()}đ
              del(class="mb-2") #{item.price.toLocaleString()}đ
              p.font-weight-bold= item.discount + "%"
              a.btn.btn-primary(href=`/tour/detail/${item.slug}`) Xem chi tiết 